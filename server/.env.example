# ═══════════════════════════════════════════════════════════════════════════
# TrustShare — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════════════════════

# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | production
ENVIRONMENT=development

# Development-only domains that skip SMTP while keeping OTPs in backend logs.
# This is an explicit test-address policy, not mailbox-existence validation.
DEV_DUMMY_EMAIL_DOMAINS=example.com,test.com,invalid,localhost

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Project uses PostgreSQL — NOT SQLite
DATABASE_URL=postgresql+psycopg2://trustshare:trustshare@localhost:5432/trustshare
REQUIRE_POSTGRESQL=true

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production
SECRET_KEY=replace-with-a-long-random-value

# ── Master Encryption Key ─────────────────────────────────────────────────────
# Must be exactly 64 hex characters (32 bytes)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Changing this key makes all previously encrypted files unreadable
MASTER_KEY_HEX=replace-with-64-character-hex-value

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail: myaccount.google.com → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── CORS Origins ──────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:8000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Microsoft OAuth2 ──────────────────────────────────────────────────────────
# portal.azure.com → App Registrations → your app → Certificates & secrets
# Redirect URI: http://localhost:8000/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# ── Dashboard Seed ────────────────────────────────────────────────────────────
DASHBOARD_SEED_ON_STARTUP=true

# ── Storage Backend ───────────────────────────────────────────────────────────
# Options: local | s3
STORAGE_BACKEND=local

# ── AWS S3 (future — set STORAGE_BACKEND=s3 to activate) ─────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=trustshare-files
AWS_S3_PREFIX=encrypted/

# ── MongoDB (optional — falls back to PostgreSQL if unavailable) ─────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=trustshare
MONGODB_COLLECTION=security_activity_logs

# ── AI File Summaries (future / optional) ────────────────────────────────────
AI_SUMMARY_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
HF_API_TOKEN=
HF_SUMMARY_MODEL=
ALLOW_EXTERNAL_AI=false
ENABLE_SUMMARY_FALLBACK=true
SUMMARY_MAX_FILE_SIZE_MB=20
SUMMARY_MAX_EXTRACTED_CHARACTERS=120000
SUMMARY_CHUNK_SIZE=12000
SUMMARY_CHUNK_OVERLAP=500
SUMMARY_REQUEST_TIMEOUT_SECONDS=90
